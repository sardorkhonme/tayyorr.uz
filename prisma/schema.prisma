generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------- Rollar / enumlar -----------------

enum Role {
  ORDERER // buyurtma beruvchi
  PREPARER // tayyorlovchi
}

enum OrderType {
  PRESENTATION // prezentatsiya
  COURSE_WORK // kurs ishi
  REFERAT
  ESSAY
  DIPLOMA
  OTHER
}

enum OrderStatus {
  OPEN // ochiq, takliflar qabul qilinmoqda
  IN_PROGRESS // tayyorlovchi tanlandi
  DELIVERED // ish topshirildi
  DONE // yakunlandi
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum FileKind {
  AVATAR
  ATTACHMENT // buyurtmaga biriktirilgan material
  DELIVERABLE // tayyor ish
}

enum WalletTxnType {
  TOPUP // hisobni to'ldirish
  SPEND // buyurtma uchun to'lov
  TRANSFER_IN // boshqa foydalanuvchidan
  TRANSFER_OUT // boshqa foydalanuvchiga
  PAYOUT // kartaga yechib olish
  REFUND // qaytarish
  HOLD // shartnoma bo'yicha eskrouga bloklandi
  RELEASE // eskroudan tayyorlovchiga o'tkazildi
  COMMISSION // sayt komissiyasi (5% / 2%)
}

enum WalletTxnStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ComplaintStatus {
  OPEN // yangi
  REVIEWING // ko'rib chiqilmoqda
  RESOLVED // hal qilindi
  DISMISSED // rad etildi
}

enum ContractStatus {
  SENT // buyurtmachi yubordi
  ACCEPTED // tayyorlovchi qabul qildi — ish boshlandi
  DECLINED // tayyorlovchi rad etdi
  CANCELLED // buyurtmachi bekor qildi
}

// shartnoma imzolangandan keyingi bekor qilish so'rovi
enum ContractCancelState {
  PENDING // so'rov yuborildi — ikkinchi tomon 3 ish kuni ichida javob beradi
  DISPUTED // ikkinchi tomon rozi bo'lmadi — admin hal qiladi
}

enum PayoutStatus {
  PENDING // so'rov yuborildi, admin ko'rib chiqmoqda
  PAID // kartaga o'tkazildi
  REJECTED // rad etildi (mablag' qaytarildi)
  CANCELLED // foydalanuvchi bekor qildi (mablag' qaytarildi)
}

// ----------------- Foydalanuvchi -----------------

model User {
  id            String    @id @default(cuid())
  // Auth.js standart maydonlari
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // tayyorr.uz maydonlari
  firstName    String?
  lastName     String?
  login        String?  @unique
  passwordHash String? // Google-only foydalanuvchida null
  role         Role?
  about        String? // qo'shimcha ma'lumot
  avatarUrl    String? // glavniy rasm (R2 public)

  // tug'ilgan sana: ro'yxatdan o'tishda o'zi kiritgan va Google profilidagi
  // (Google ruxsat bersa; yil ko'rsatilmagan bo'lsa "--MM-DD" ko'rinishida)
  birthDate      DateTime? @db.Date
  googleBirthday String?

  // faqat PREPARER uchun ma'noli
  isAvailable Boolean @default(true) // band emas = true
  ratingSum   Int     @default(0)
  ratingCount Int     @default(0)

  // hamyon (balans so'mda saqlanadi)
  balance    Int     @default(0)
  walletCode String? @unique // qisqa hisob kodi, masalan "TYR-8FK2"

  // star hisobi (pulda emas, alohida sanoq — sotib olinadi, keyin sarflanadi)
  starBalance Int @default(0)

  // admin cheklovi (ban)
  bannedUntil DateTime? // shu sanagacha cheklangan; null = cheklanmagan
  banReason   String?

  isSupport  Boolean   @default(false) // "tayyorr.uz support" tizim hisobi
  isPlatform Boolean   @default(false) // sayt komissiya hisobi
  lastSeenAt DateTime? // oxirgi faollik (online holati)
  locale     String? // "uz" | "ru" | "en" — tanlangan til
  theme      String? // "light" | "dark"

  // ommaviy oferta / foydalanish shartlariga rozilik
  termsAcceptedAt DateTime?
  termsVersion    String?

  // foydalanuvchi Tayyorr.uz ni qayerdan eshitgani
  hearAboutUs String? // "instagram" | "telegram" | "ai" | "google" | "friend" | "other"

  // qaysi tashriflar (referral) havolasi orqali ro'yxatdan o'tgan (admin havolasi)
  referralLinkId String?
  referralLink   ReferralLink? @relation(fields: [referralLinkId], references: [id], onDelete: SetNull)

  // shaxsiy (foydalanuvchidan-foydalanuvchiga) referal — kim taklif qilgan.
  // Taklif qiluvchiga yangi a'zo ro'yxatdan o'tganda 1 star beriladi.
  referredById String?
  referredBy   User?   @relation("PeerReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers User[] @relation("PeerReferrals")

  // shaxsiy bildirishnoma boti bilan bog'langan Telegram chat
  telegramChatId    String?
  telegramUsername  String?
  telegramLinkedAt  DateTime?
  telegramBlockedAt DateTime? // foydalanuvchi botni bloklagan (xabar 403 qaytarganda qayd qilinadi)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  ordersCreated     Order[]             @relation("OrdererOrders")
  ordersTaken       Order[]             @relation("PreparerOrders")
  offers            Offer[]
  files             FileObject[]
  walletTxns        WalletTransaction[]
  conversationsA    Conversation[]      @relation("ConvUserA")
  conversationsB    Conversation[]      @relation("ConvUserB")
  messages          Message[]
  complaintsMade    Complaint[]         @relation("ComplaintsMade")
  complaintsAgainst Complaint[]         @relation("ComplaintsAgainst")
  reviewsGiven      Review[]            @relation("ReviewsGiven")
  reviewsReceived   Review[]            @relation("ReviewsReceived")
  blocksMade        Block[]             @relation("BlocksMade")
  blocksReceived    Block[]             @relation("BlocksReceived")
  contractsSent     Contract[]          @relation("ContractsSent")
  contractsGot      Contract[]          @relation("ContractsGot")
  pushSubscriptions PushSubscription[]
  deviceTokens      DeviceToken[]
  payoutRequests    PayoutRequest[]
  reactions         MessageReaction[]
  activityLogs      ActivityLog[]
  announcementClicks AnnouncementClick[]
  siteVisits         SiteVisit[]
  appDownloads       AppDownload[]

  @@index([role, isAvailable])
}

// ----------------- Faoliyat jurnali (admin uchun) -----------------

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // "ORDER_CREATE", "OFFER_CREATE", "AUTH_LOGIN" ...
  summary   String // inson o'qiy oladigan qisqa tavsif (uz)
  meta      Json? // qo'shimcha kontekst (orderId, amount, ...)
  ip        String?
  userAgent String? // brauzer/qurilma (User-Agent, xom holda)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/**
 * Foydalanuvchi saytga (allaqachon tizimga kirgan holda) tashrif buyurgani —
 * login emas, oddiy ko'rib chiqish. /api/me/visit orqali yoziladi — klient
 * (VisitPing) har yangi brauzer sessiyasida (tab ochilganda) bir marta
 * chaqiradi, shuning uchun har yozuv — alohida tashrif.
 */
model SiteVisit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ----------------- Tashriflar (referral havolalar) -----------------

model ReferralLink {
  id        String   @id @default(cuid())
  name      String // admin bergan nom (masalan "Instagram reklama")
  code      String   @unique // /r/<code> — tasodifiy belgilar
  visits    Int      @default(0) // havola necha marta ochilgani
  createdAt DateTime @default(now())

  users User[] // shu havola orqali ro'yxatdan o'tganlar

  @@index([createdAt])
}

model PayoutRequest {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // so'm — so'rovda balansdan yechiladi
  card      String // to'liq karta raqami (admin o'tkazadi)
  cardName  String? // karta egasi
  status    PayoutStatus @default(PENDING)
  adminNote String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Contract {
  id         String         @id @default(cuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ordererId  String
  orderer    User           @relation("ContractsSent", fields: [ordererId], references: [id], onDelete: Cascade)
  preparerId String
  preparer   User           @relation("ContractsGot", fields: [preparerId], references: [id], onDelete: Cascade)
  amount     Int // kelishilgan summa (so'm) — buyurtmachidan eskrouga bloklanadi
  note       String? // batafsil tavsif / shartlar
  deadline   DateTime?
  status     ContractStatus @default(SENT)

  // ish topshirilgach: buyurtmachi tekshiradi, reviewDueAt'gacha javob
  // bermasa ish muvaffaqiyatli yakunlanadi (pul tayyorlovchiga)
  deliveredAt   DateTime?
  reviewDueAt   DateTime?
  revisionCount Int       @default(0)

  // bekor qilish so'rovi (imzolangan shartnomani bir tomonlama bekor qilib bo'lmaydi)
  cancelState         ContractCancelState?
  cancelRequestedById String?
  cancelReason        String?
  cancelRequestedAt   DateTime?
  cancelDueAt         DateTime? // shu vaqtgacha javob bo'lmasa — rozi deb hisoblanadi
  cancelRejectReason  String?
  disputeResolution   String? // admin qarori: CANCEL | CONTINUE | COMPLETE
  disputeNote         String?
  disputeResolvedAt   DateTime?

  // yakuniy taqsimot (hal qilinganda to'ldiriladi)
  commissionAmount Int? // saytga
  payoutAmount     Int? // tayyorlovchiga
  refundAmount     Int? // buyurtmachiga qaytdi

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([orderId, status])
  @@index([preparerId, status])
  @@index([cancelState])
}

model Broadcast {
  id         String    @id @default(cuid())
  body       String
  bodyRu     String?
  bodyEn     String?
  fileKey    String?
  fileName   String?
  fileType   String?
  fileSize   Int?
  role       String?
  balanceMin Int?
  balanceMax Int?
  regFrom    DateTime?
  regTo      DateTime?
  sentCount  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

model Announcement {
  id           String   @id @default(cuid())
  title        String
  titleRu      String?
  titleEn      String?
  body         String
  bodyRu       String?
  bodyEn       String?
  buttonText   String?
  buttonTextRu String?
  buttonTextEn String?
  buttonUrl    String?
  role         String? // null = hammaga, "ORDERER" | "PREPARER"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clicks AnnouncementClick[]

  @@index([active, createdAt])
}

/** E'lon bannerdagi tugmani kim bosgani (admin ko'rishi uchun). */
model AnnouncementClick {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([announcementId, userId])
  @@index([announcementId, createdAt])
}

/** Hero bo'limining fon videosi — bitta faol video (singleton). */
model HeroVideo {
  id        String   @id @default(cuid())
  videoUrl  String
  videoKey  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, createdAt])
}

/**
 * Telegram bot orqali akkaunt ulash jarayonining vaqtinchalik holati
 * (bitta Telegram chat — bitta faol so'rov). Email so'ralganda userId
 * hali bo'sh, kod yuborilgach to'ldiriladi.
 */
model TelegramLinkSession {
  id        String    @id @default(cuid())
  chatId    String    @unique
  userId    String?
  code      String?
  attempts  Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model LandingFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model LandingVideo {
  id        String   @id @default(cuid())
  title     String
  videoUrl  String
  videoKey  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

/**
 * Landingdagi "yuklab olish"dan oldingi scroll-hikoya bo'limi uchun
 * har bir slayd — sarlavha + submatn + telefon ekranida ko'rinadigan rasm.
 */
model LandingPhoneSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  imageUrl  String
  imageKey  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Mobil ilova (FCM) push tokeni — ilova yopiq bo'lsa ham xabar yetkazish uchun.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  raterId   String // buyurtma beruvchi
  rater     User     @relation("ReviewsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  targetId  String // tayyorlovchi
  target    User     @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  stars     Int // 1..5
  comment   String?
  createdAt DateTime @default(now())

  @@index([targetId, createdAt])
}

model WalletTransaction {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      WalletTxnType
  status    WalletTxnStatus @default(SUCCESS)
  amount    Int // musbat qiymat; yo'nalish type orqali aniqlanadi
  method     String          @default("DEMO") // DEMO | CLICK | PAYME | ADMIN
  note       String?
  meta       Json?
  reversedAt DateTime? // admin bekor qilgan sana
  createdAt  DateTime        @default(now())

  @@index([userId, createdAt])
}

// ----------------- Messenger (real-time chat) -----------------

model Conversation {
  id      String  @id @default(cuid())
  // juftlik doim tartiblangan saqlanadi: userAId < userBId
  userAId String
  userA   User    @relation("ConvUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId String
  userB   User    @relation("ConvUserB", fields: [userBId], references: [id], onDelete: Cascade)
  // qaysi buyurtma kontekstida boshlangani (ixtiyoriy)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  hiddenFromUsersAt DateTime? // admin foydalanuvchilardan yashirgan (bazada qoladi)
  deletedByUsersAt  DateTime? // foydalanuvchi ikki tomondan o'chirgan (adminда qoladi)

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String       @default("")
  system         Boolean      @default(false) // tizim/support xabari
  // tizim xabari qaysi buyurtmaga tegishli — ostidagi "Buyurtmani ko'rish" tugmasi shu yerga olib boradi
  orderId        String?

  // ixtiyoriy fayl (R2 private bucket)
  fileKey  String?
  fileName String?
  fileType String?
  fileSize Int?

  // tahrirlash / o'chirish
  editedAt  DateTime? // oxirgi tahrirlangan vaqt
  deletedAt DateTime? // "hamma uchun o'chirish" — foydalanuvchilarga ko'rinmaydi, adminда qoladi

  // javob (reply)
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  broadcastId String? // ommaviy xabar bo'lsa — guruh id

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  readAt    DateTime?

  revisions MessageRevision[]
  reactions MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([conversationId, updatedAt])
  @@index([broadcastId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     String // "LIKE" | "DISLIKE"
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

model MessageRevision {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  body      String // shu versiya (almashtirilishдан oldingi holat)
  createdAt DateTime @default(now())

  @@index([messageId, createdAt])
}

model Complaint {
  id         String          @id @default(cuid())
  reporterId String
  reporter   User            @relation("ComplaintsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  suspectId  String?
  suspect    User?           @relation("ComplaintsAgainst", fields: [suspectId], references: [id], onDelete: SetNull)
  orderId    String?
  messageId  String? // muayyan xabar ustidan shikoyat
  body       String
  status     ComplaintStatus @default(OPEN)
  adminNote  String?
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

// ----------------- Auth.js adapter modellari -----------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------- Buyurtmalar -----------------

model Order {
  id          String      @id @default(cuid())
  ordererId   String
  orderer     User        @relation("OrdererOrders", fields: [ordererId], references: [id], onDelete: Cascade)
  preparerId  String?
  preparer    User?       @relation("PreparerOrders", fields: [preparerId], references: [id], onDelete: SetNull)

  title       String
  type        OrderType   @default(OTHER)
  description String
  deadline    DateTime?
  budget      Int? // so'mda
  status      OrderStatus @default(OPEN)

  telegramMessageId Int? // kanaldagi post message_id (status o'zgarganda tahrirlanadi)
  telegramStatus    Int? // oxirgi Telegram API javob kodi (200 / 400 ...)
  telegramSentAt    DateTime? // kanalga muvaffaqiyatli joylangan vaqt
  telegramError     String? // xato bo'lsa qisqa matn

  deletedAt     DateTime? // o'chirilgan (buyurtmachida qoladi, boshqalarga ko'rinmaydi)
  deletedByRole String? // "ORDERER" | "ADMIN"
  deleteReason  String? // admin o'chirganda — sabab

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers        Offer[]
  files         FileObject[]
  conversations Conversation[]
  review        Review?
  contracts     Contract[]

  @@index([status, createdAt])
}

model Offer {
  id         String      @id @default(cuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  preparerId String
  preparer   User        @relation(fields: [preparerId], references: [id], onDelete: Cascade)
  price      Int
  message    String?
  status     OfferStatus @default(PENDING)
  starsSpent Int         @default(2) // ariza uchun to'langan star (navbatdagi o'rinni belgilaydi)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, preparerId])
  @@index([preparerId, status])
  @@index([orderId, starsSpent, createdAt])
}

model FileObject {
  id         String   @id @default(cuid())
  key        String   @unique // R2 obyekt kaliti
  bucket     String // "public" yoki "private"
  kind       FileKind
  mimeType   String
  size       Int
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

/** Landingdagi "Ilovani yuklab olish" (APK) tugmasi bosilgani. */
model AppDownload {
  id        String   @id @default(cuid())
  userId    String? // tizimga kirgan bo'lsa
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Umumiy sozlamalar (kalit — qiymat), admin paneldan o'zgartiriladi.
// Masalan: "versionLabel" — sayt va ilovadagi akkaunt bo'limi ostida ko'rsatiladigan versiya.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
