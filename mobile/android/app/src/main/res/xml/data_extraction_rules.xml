<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: ilova ma'lumotlari bulutga zaxiralanmasin va boshqa qurilmaga ko'chirilmasin.
     Aks holda shifrlangan token yangi qurilmada o'qilmay, ilova ochilishda qotib qolishi mumkin. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
